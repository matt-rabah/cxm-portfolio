---
import Layout from '../layouts/Layout.astro';
const experiences = [
  { id:'cadence', years:'2024 — Present', role:'Customer Success Consultant', company:'Cadence Lab', sector:'Independent consulting · Detroit', summary:'Designing practical customer success systems for retail, QSR, cannabis, and service businesses, with a focus on lifecycle clarity, faster value, and repeat engagement.', metrics:[['6','client programs'],['14%','avg. lift in adoption'],['18%','faster time-to-value']], bullets:['Redesigned customer lifecycles and retention programs across six client engagements.','Rebuilt sales-to-service handoffs through Salesforce workflows and clearer onboarding standards.','Created HubSpot automations that returned roughly four hours per employee each week.','Built customer health and engagement frameworks to surface risk before escalation.'] },
  { id:'shinola', years:'2022 — 2024', role:'Customer Experience Manager', company:'Shinola', sector:'Luxury retail & manufacturing · Detroit', summary:'Directed customer experience for the flagship operation and a high-value retail and corporate portfolio, connecting CRM discipline with service execution and commercial outcomes.', metrics:[['$8M','annual portfolio'],['1,100+','CRM accounts'],['35%','fewer escalations']], bullets:['Segmented 1,100+ Salesforce accounts and raised CRM-driven outreach completion from 32% to 86%.','Reworked inconsistent customer handoffs and service workflows, reducing escalations by 35%.','Led 70+ brand, corporate, and experiential events that generated approximately $750K.','Expanded VIP engagement across retail, e-commerce, and B2B customer channels.'] },
  { id:'neurosync', years:'2019 — 2022', role:'Customer Success Manager', company:'NeuroSync', sector:'AI-enabled health technology · Southfield', summary:'Owned implementation and post-launch success across clinical and legal accounts for an AI-enabled diagnostic platform where trust, workflow fit, and compliance shaped adoption.', metrics:[['32','clinical accounts'],['95%','3-year retention'],['45→72%','active usage']], bullets:['Rebuilt onboarding around real clinical workflows, increasing active platform usage from 45% to 72%.','Created an account health model from CRM and product usage signals without a dedicated CS platform.','Managed stakeholder alignment, configuration, training, and first-90-day support across 32 accounts.','Worked with clinical and legal stakeholders to align value with workflow, compliance, and data needs.'] }
];
---
<Layout title="Matthew Rabah | Customer Experience Management" description="Customer experience and customer success portfolio for Matthew Rabah, focused on implementation, adoption, retention, and CRM operations.">
<header class="site-header"><a class="wordmark" href="#top" aria-label="Matthew Rabah, home">MR<span>.</span></a><nav aria-label="Primary navigation"><a href="#work">Work</a><a href="#approach">Approach</a><a href="#contact">Contact</a></nav></header>
<main id="top">
  <section class="hero section-shell" aria-labelledby="hero-title"><div class="eyebrow"><span></span> Detroit, Michigan · CX & Customer Success</div><h1 id="hero-title">I turn complex customer journeys into <em>clear, usable systems.</em></h1><div class="hero-bottom"><p>Customer experience leader working across implementation, adoption, CRM operations, and retention in healthtech, premium retail, and consulting.</p><a class="button" href="#work">View selected work <span aria-hidden="true">↓</span></a></div><div class="signal-strip" aria-label="Career highlights"><div><strong>8+</strong><span>Years in CX & CS</span></div><div><strong>95%</strong><span>Three-year retention</span></div><div><strong>1,100+</strong><span>Accounts segmented</span></div><div><strong>32</strong><span>Clinical implementations</span></div></div></section>
  <section class="work section-shell" id="work" aria-labelledby="work-title"><div class="section-intro"><p class="kicker">01 / Selected experience</p><h2 id="work-title">Operating where customer needs, business goals, and frontline reality meet.</h2></div><div class="experience-list">{experiences.map((experience,index)=><article class="experience" id={experience.id}><div class="experience-index">0{index+1}</div><div class="experience-heading"><p>{experience.years}</p><h3>{experience.role}</h3><h4>{experience.company}</h4><span>{experience.sector}</span></div><div class="experience-body"><p class="experience-summary">{experience.summary}</p><div class="metrics">{experience.metrics.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</div><details><summary>Selected outcomes <span aria-hidden="true">+</span></summary><ul>{experience.bullets.map(bullet=><li>{bullet}</li>)}</ul></details></div></article>)}</div></section>
  <section class="approach" id="approach" aria-labelledby="approach-title"><div class="section-shell approach-grid"><div><p class="kicker light">02 / How I work</p><h2 id="approach-title">Customer experience is an operating discipline.</h2></div><div class="principles"><article><span>01</span><div><h3>Find the friction</h3><p>Use journey evidence, product behavior, and frontline feedback to separate symptoms from root causes.</p></div></article><article><span>02</span><div><h3>Design the system</h3><p>Turn insight into ownership, workflows, playbooks, health signals, and measurable success criteria.</p></div></article><article><span>03</span><div><h3>Make adoption practical</h3><p>Fit change into the way people actually work, especially when trust, compliance, or technical complexity matters.</p></div></article></div></div></section>
  <section class="credentials section-shell" aria-labelledby="credentials-title"><p class="kicker">03 / Foundation</p><h2 id="credentials-title">Strategy backed by operating experience.</h2><div class="credential-grid"><article><span>Education</span><h3>M.S., Customer Experience Management</h3><p>Michigan State University · Eli Broad College of Business</p></article><article><span>Certification</span><h3>Salesforce Certified Agentforce Specialist</h3><p>Applied AI, CRM, automation, and trusted customer workflows</p></article><article><span>Speaking</span><h3>CX operations, loyalty, and systems thinking</h3><p>CreativeMornings Detroit · MSU CXM360 · University of Michigan</p></article></div></section>
  <section class="contact section-shell" id="contact" aria-labelledby="contact-title"><p class="kicker">04 / Contact</p><h2 id="contact-title">Building a customer operation that needs more clarity?</h2><div class="contact-row"><a href="mailto:rabah.matthew@gmail.com">rabah.matthew@gmail.com <span>↗</span></a><a href="https://www.linkedin.com/in/mattrabah" rel="noreferrer">LinkedIn <span>↗</span></a></div></section>
</main><footer class="section-shell"><span>Matthew Rabah</span><span>Customer Experience · Customer Success · CRM</span><span>© {new Date().getFullYear()}</span></footer>
</Layout>
